# Generated resources are compared byte-for-byte with their locale sources.
# Keep their canonical LF endings when Git checks them out on Windows.
src-tauri/windows-locales.nsh text eol=lf
src-tauri/locales/**/*.strings text eol=lf

# Tauri rewrites this manifest while configuring the Windows build.
src-tauri/Cargo.toml text eol=lf
