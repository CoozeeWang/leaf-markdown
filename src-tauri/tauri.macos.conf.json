{
  "build": {
    "beforeBuildCommand": "node scripts/sync-macos-locales.mjs --check && npm run build"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {"width":660,"height":480},
        "appPosition": {"x":180,"y":180},
        "applicationFolderPosition": {"x":480,"y":180}
      }
    },
    "resources": {
      "icons/document-icon.icns": "document-icon.icns",
      "locales/en.lproj/ServicesMenu.strings": "en.lproj/ServicesMenu.strings",
      "locales/zh-Hans.lproj/ServicesMenu.strings": "zh-Hans.lproj/ServicesMenu.strings",
      "locales/zh-Hant.lproj/ServicesMenu.strings": "zh-Hant.lproj/ServicesMenu.strings"
    }
  }
}
